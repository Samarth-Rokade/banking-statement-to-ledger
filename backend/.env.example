# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string, e.g.:
# postgresql+psycopg://user:password@localhost:5432/banking_ledger
DATABASE_URL=

# JWT signing
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini API
GEMINI_API_KEY=
AI_MODEL_LEDGER_PREDICTION=gemini-2.5-pro
AI_BATCH_SIZE=40
AI_AUTO_ACCEPT_THRESHOLD=90
AI_NEW_LEDGER_CONFIDENCE_CAP=85
AI_MAX_LEDGER_CONTEXT=150

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Where uploaded statement files are stored on disk (relative to backend/ or absolute)
STORAGE_DIR=storage/uploads
MAX_UPLOAD_SIZE_BYTES=20971520
