# Copy this file to .env and fill in real values. Never commit .env itself.

# "development" (default) or "production". Setting "production" turns on
# Settings.validate_for_production()'s checks at startup - the app refuses to boot
# if e.g. SECRET_KEY was left at its default or STORAGE_BACKEND is still "local".
# See DEPLOY.md for the full Cloud Run production checklist.
ENVIRONMENT=development

# PostgreSQL connection string, e.g.:
# postgresql+psycopg://user:password@localhost:5432/banking_ledger
# On Cloud Run with Cloud SQL, use the unix socket form instead:
# postgresql+psycopg://user:password@/banking_ledger?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# JWT signing
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini API
GEMINI_API_KEY=
AI_MODEL_LEDGER_PREDICTION=gemini-2.5-pro
AI_BATCH_SIZE=40
AI_AUTO_ACCEPT_THRESHOLD=90
AI_NEW_LEDGER_CONFIDENCE_CAP=85
AI_MAX_LEDGER_CONTEXT=150

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# "local" (default) writes to local disk - fine for dev, but Cloud Run containers
# are ephemeral and don't share a filesystem across instances, so production must
# use "gcs" with GCS_BUCKET_NAME set.
STORAGE_BACKEND=local
# Where uploaded statement files are stored on disk (relative to backend/ or absolute)
STORAGE_DIR=storage/uploads
GCS_BUCKET_NAME=
MAX_UPLOAD_SIZE_BYTES=20971520

# Runs the job worker loop in a background thread of this process. Leave true for
# local dev (one process is enough). In production, deploy the worker as its own
# Cloud Run service instead (see DEPLOY.md) and set this false on the API service.
RUN_WORKER_IN_PROCESS=true
WORKER_POLL_INTERVAL_SECONDS=2.0
