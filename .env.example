# Copy to .env (next to docker-compose.yml), fill in real values, then run:
#   docker compose up -d --build
# Never commit the real .env.

# ---- PostgreSQL ----
POSTGRES_USER=ledger_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=banking_ledger

# ---- Backend ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string
GEMINI_API_KEY=
# Optional overrides - leave unset to use the backend's own defaults
AI_MODEL_LEDGER_PREDICTION=gemini-3.1-pro-preview
AI_BATCH_SIZE=40
AI_AUTO_ACCEPT_THRESHOLD=90
AI_NEW_LEDGER_CONFIDENCE_CAP=85
AI_MAX_LEDGER_CONTEXT=150

# Comma-separated origins allowed to call the API. Must include the address
# the frontend is actually served from (browser Origin header, no trailing slash).
# e.g. http://203.0.113.10 if FRONTEND_PORT=80, or http://203.0.113.10:8080 otherwise.
CORS_ORIGINS=http://YOUR_VM_IP_OR_DOMAIN

# Optional Tally export settings
TALLY_BANK_LEDGER_NAME=Bank Account
TALLY_COMPANY_NAME=

# ---- Frontend ----
# Baked into the frontend bundle at BUILD time (Vite), so it must already be
# the address the browser will use to reach the backend, e.g.:
#   http://YOUR_VM_IP_OR_DOMAIN:8000/api/v1
VITE_BACKEND_URL=http://YOUR_VM_IP_OR_DOMAIN:8000/api/v1

# ---- Ports exposed on the VM host ----
BACKEND_PORT=8000
FRONTEND_PORT=80
